{
  "expo": {
    "name": "SecureSphere",
    "slug": "securesphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "securesphere",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B18"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.priyahm25.securesphere",
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#050B18"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#050B18"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0066FF",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d20339ec-b21d-410d-a5fb-ea5654b24d0e"
      }
    },
    "owner": "priyahm25"
  }
}
