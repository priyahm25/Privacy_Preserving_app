# TEMPLATE ONLY - this file IS committed. Put real values in .env next to it.
#
# Expo reads .env from THIS directory (the one with app.json), not the repo
# root, so the app's variables live here rather than in the root .env.
#
# Everything here is bundled into the client and readable by anyone who
# installs the app. Only EXPO_PUBLIC_* values belong in this file.
# Never put SUPABASE_SERVICE_ROLE_KEY or CLERK_SECRET_KEY here - those are
# server-only and go in the root .env. File and search keys stay on-device.

# Clerk publishable key (starts with pk_).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z3JhdGVmdWwtbWl0ZS0zNy5jbGVyay5hY2NvdW50cy5kZXYk

# Where the API server is reachable. Must match PORT in the root .env.
EXPO_PUBLIC_API_URL=http://localhost:3000
